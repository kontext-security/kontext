{
  "version": "rules/5",
  "keyNormalization": "camel_to_snake",
  "keyPatterns": [
    {
      "id": "sensitive-key",
      "description": "Object keys that denote credentials; their values are replaced wholesale.",
      "pattern": "(^|[_-])(authorization|auth|api[_-]?key|access[_-]?(?:key|token)|refresh[_-]?token|client[_-]?secret|token|secret|password|passwd|pwd|pass|credential|private[_-]?key|session[_-]?key)($|[_-])",
      "caseInsensitive": true,
      "provenance": "structural"
    }
  ],
  "valuePatterns": [
    {
      "id": "private-key-block",
      "description": "PEM private key blocks.",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "caseInsensitive": false,
      "provenance": "gitleaks:private-key"
    },
    {
      "id": "authorization-header",
      "description": "Authorization header values, with or without an authentication scheme.",
      "pattern": "\\b(Authorization\\s*:\\s*(?:(?:Bearer|Basic)\\s+)?)(?:\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'|`(?:\\\\.|[^`\\\\])*`|[^\\s&;|)\"'`]+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'|`(?:\\\\.|[^`\\\\])*`|[^\\s&;|)\"'`]+|\"[^\\s\"][^\"]*$|'[^\\s'][^']*$|`[^\\s`][^`]*$)*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "bearer-auth",
      "description": "Bare Bearer authorization values shaped like credentials (8+ token characters); header context of any length is covered by authorization-header.",
      "pattern": "\\b(Bearer\\s+)[A-Za-z0-9._~+/=-]{8,}",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "basic-auth",
      "description": "Bare Basic authorization values shaped like credentials (8+ token characters); header context of any length is covered by authorization-header.",
      "pattern": "\\b(Basic\\s+)[A-Za-z0-9._~+/=-]{8,}",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "json-sensitive-property",
      "description": "String values of credential-bearing properties in JSON embedded in flat text.",
      "pattern": "(\"(?:[A-Za-z0-9_-]*(?:api[_-]?key|access[_-]?(?:key|token)|refresh[_-]?token|client[_-]?secret|token|secret|password|passwd|credential|private[_-]?key)[A-Za-z0-9_-]*|(?:[A-Za-z0-9]+[_-])*(?:pwd|pass)(?:[_-][A-Za-z0-9]+)*)\"\\s*:\\s*)\"(?:\\\\.|[^\"\\\\])*\"",
      "replacement": "$1\"[REDACTED_SECRET]\"",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "github-token",
      "description": "GitHub classic tokens (ghp/gho/ghu/ghs/ghr).",
      "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{16,}\\b",
      "caseInsensitive": false,
      "provenance": "gitleaks:github-pat"
    },
    {
      "id": "github-fine-grained-pat",
      "description": "GitHub fine-grained personal access tokens.",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{16,}\\b",
      "caseInsensitive": false,
      "provenance": "gitleaks:github-fine-grained-pat"
    },
    {
      "id": "openai-api-key",
      "description": "OpenAI-style secret keys.",
      "pattern": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{16,}\\b",
      "caseInsensitive": false,
      "provenance": "gitleaks:openai-api-key"
    },
    {
      "id": "aws-access-key-id",
      "description": "AWS access key identifiers.",
      "pattern": "(?:AKIA|ASIA)[A-Z0-9]{16}",
      "caseInsensitive": false,
      "provenance": "gitleaks:aws-access-token"
    },
    {
      "id": "slack-token",
      "description": "Slack bot/app/user tokens, also glued to a name (`ci_xoxb-...`).",
      "pattern": "(?:xox[abcdeoprs]|xwfp)-[A-Za-z0-9-]{16,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:slack-bot-token"
    },
    {
      "id": "npm-token",
      "description": "npm access tokens, also glued to a name.",
      "pattern": "npm_[A-Za-z0-9]{16,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:npm-access-token"
    },
    {
      "id": "slack-app-token",
      "description": "Slack app-level tokens (`xapp-1-A…-123…-abc…`).",
      "pattern": "xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]{16,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:slack-app-token"
    },
    {
      "id": "gitlab-token",
      "description": "GitLab personal, deploy, runner, trigger, SCIM, CI build and OAuth tokens, also glued to a name (`ciglpat-...`); a CI job token's JWT parts go with it.",
      "pattern": "(?:glpat|gldt|glrtr|glrt|glptt|glsoat|glcbt|gloas|glft|glwt|glagent|glimt|glffct)-[A-Za-z0-9_-]{20,}(?:\\.[A-Za-z0-9_-]*){0,2}",
      "caseInsensitive": false,
      "provenance": "gitleaks:gitlab-pat"
    },
    {
      "id": "pypi-token",
      "description": "PyPI upload tokens (a macaroon, so `pypi-AgE…`; a package named `pypi-…` is not one).",
      "pattern": "pypi-AgE[A-Za-z0-9_-]{8,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:pypi-upload-token"
    },
    {
      "id": "stripe-key",
      "description": "Stripe secret and restricted keys, organization keys included (`sk_org_live_…`).",
      "pattern": "[sr]k_(?:(?:org_)?(?:live|test)|org)_[A-Za-z0-9]{24,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:stripe-access-token"
    },
    {
      "id": "shopify-token",
      "description": "Shopify access, shared-secret, custom-app and private-app tokens.",
      "pattern": "shp(?:at|ss|ca|pa)_[A-Za-z0-9]{16,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:shopify-access-token"
    },
    {
      "id": "digitalocean-token",
      "description": "DigitalOcean personal, OAuth and refresh tokens.",
      "pattern": "do[opr]_v1_[A-Za-z0-9]{16,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:digitalocean-pat"
    },
    {
      "id": "huggingface-token",
      "description": "Hugging Face access tokens.",
      "pattern": "hf_(?:oauth_)?[A-Za-z0-9]{30,}",
      "caseInsensitive": false,
      "provenance": "gitleaks:huggingface-access-token"
    },
    {
      "id": "sendgrid-key",
      "description": "SendGrid API keys: `SG.`, a 22-character id, a dot and a 43-character secret.",
      "pattern": "SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}",
      "caseInsensitive": false,
      "provenance": "gitleaks:sendgrid-api-token"
    },
    {
      "id": "gcp-api-key",
      "description": "Google Cloud API keys.",
      "pattern": "\\bAIza[0-9A-Za-z_-]{20,}\\b",
      "caseInsensitive": false,
      "provenance": "gitleaks:gcp-api-key"
    },
    {
      "id": "jwt",
      "description": "JSON Web Tokens and other signed values: two parts or more, short claims, no signature (`eyJ….e30.`), encrypted in five parts, or a header with a space (`eyAi…`). Glued after `_` or `-`, never inside a word (`keyJson…`).",
      "pattern": "(^|[^A-Za-z0-9])(?:eyJ|eyAi)[A-Za-z0-9_-]{8,}\\.(?:[A-Za-z0-9_-]{2,}(?:\\.[A-Za-z0-9_-]*)?|[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]{2,}(?:\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]*)?)",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "gitleaks:jwt"
    },
    {
      "id": "url-userinfo",
      "description": "Credentials embedded in URLs of any scheme (postgres, mysql, mongodb+srv, redis, amqp, https, ...): the whole userinfo through the last @ before the host, keeping the scheme.",
      "pattern": "([a-z][a-z0-9+.-]{0,31}://)[^/?#\\s\"<>]+@",
      "replacement": "$1[REDACTED_SECRET]@",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "mysql-password-flag",
      "description": "MySQL and MariaDB client passwords glued to -p (mysql -pSECRET, mysqldump -p'SECRET'), also after grouped options that take no argument (mysql -vpSECRET), also when the executable itself is quoted (\"/usr/bin/mysql\" -pSECRET). Only the glued form: mysql -p db prompts and db is the database; -P is the port. The flag must sit in the same shell command as the client (no unquoted ; & | or newline in between; a backslash-newline continues it). Every later password argument of the same command is masked too, with what lies between.",
      "pattern": "\\b((?:mysql(?:dump|admin|import|check|show|pump|sh|binlog|slap)?|mariadb(?:-[a-z]+)?)(?:\\.exe)?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+(?:-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*))*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "structural"
    },
    {
      "id": "mysql-quoted-password-flag",
      "description": "The same when the first password argument is quoted as a whole (mysql '-pMy pass', also in \"...\" or $'...'): the whole argument is masked, quotes included.",
      "pattern": "\\b((?:mysql(?:dump|admin|import|check|show|pump|sh|binlog|slap)?|mariadb(?:-[a-z]+)?)(?:\\.exe)?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+)(?:'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*)(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+(?:-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*))*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "structural"
    },
    {
      "id": "sshpass-password-flag",
      "description": "sshpass -p passwords, glued, spaced or grouped (-vp). sshpass wraps a command, so only its own options (with the arguments of -P, -f and -d, also grouped as -vP) may come before -p, quoted or not: in sshpass -e ssh -p 2222 the -p belongs to ssh and is kept. Every later -p of sshpass is masked too.",
      "pattern": "\\b(sshpass(?:\\.exe)?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+(?:[\\\"']?-v*[fdP][\\\"']?(?:[ \\t]|\\\\\\r?\\n)*(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|[\\\"']?-[^\\t\\n\\f\\r ;&|]*))*?(?:[ \\t]|\\\\\\r?\\n)+-v*p(?:[ \\t]|\\\\\\r?\\n)*)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+(?:[\\\"']?-v*[fdP][\\\"']?(?:[ \\t]|\\\\\\r?\\n)*(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|[\\\"']?-[^\\t\\n\\f\\r ;&|]*))*?(?:[ \\t]|\\\\\\r?\\n)+(?:(?:'-v*p'|\"-v*p\")(?:[ \\t]|\\\\\\r?\\n)+(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &