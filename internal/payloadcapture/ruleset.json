{
  "version": "rules/5",
  "keyNormalization": "camel_to_snake",
  "keyPatterns": [
    {
      "id": "sensitive-key",
      "description": "Object keys that denote credentials; their values are replaced wholesale.",
      "pattern": "(^|[_-])(authorization|auth|api[_-]?key|access[_-]?(?:key|token)|refresh[_-]?token|client[_-]?secret|token|secret|password|passwd|pwd|pass|credential|private[_-]?key|session[_-]?key|gitlab[_-]session)($|[_-])",
      "caseInsensitive": true,
      "provenance": "structural"
    }
  ],
  "valuePatterns": [
    {
      "id": "private-key-block",
      "description": "PEM private key blocks.",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "caseInsensitive": false,
      "provenance": "gitleaks:private-key"
    },
    {
      "id": "authorization-header",
      "description": "Authorization header values, with or without an authentication scheme.",
      "pattern": "\\b(Authorization\\s*:\\s*(?:(?:Bearer|Basic)\\s+)?)(?:\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'|`(?:\\\\.|[^`\\\\])*`|[^\\s&;|)\"'`]+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'|`(?:\\\\.|[^`\\\\])*`|[^\\s&;|)\"'`]+|\"[^\\s\"][^\"]*$|'[^\\s'][^']*$|`[^\\s`][^`]*$)*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "bearer-auth",
      "description": "Bare Bearer authorization values shaped like credentials (8+ token characters); header context of any length is covered by authorization-header.",
      "pattern": "\\b(Bearer\\s+)[A-Za-z0-9._~+/=-]{8,}",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "basic-auth",
      "description": "Bare Basic authorization values shaped like credentials (8+ token characters); header context of any length is covered by authorization-header.",
      "pattern": "\\b(Basic\\s+)[A-Za-z0-9._~+/=-]{8,}",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "json-sensitive-property",
      "description": "String values of credential-bearing properties in JSON embedded in flat text.",
      "pattern": "(\"(?:[A-Za-z0-9_-]*(?:api[_-]?key|access[_-]?(?:key|token)|refresh[_-]?token|client[_-]?secret|token|secret|password|passwd|credential|private[_-]?key)[A-Za-z0-9_-]*|(?:[A-Za-z0-9]+[_-])*(?:pwd|pass)(?:[_-][A-Za-z0-9]+)*)\"\\s*:\\s*)\"(?:\\\\.|[^\"\\\\])*\"",
      "replacement": "$1\"[REDACTED_SECRET]\"",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "url-userinfo",
      "description": "Credentials embedded in URLs of any scheme (postgres, mysql, mongodb+srv, redis, amqp, https, ...): the whole userinfo through the last @ before the host, keeping the scheme.",
      "pattern": "([a-z][a-z0-9+.-]{0,31}://)[^/?#\\s\"<>]+@",
      "replacement": "$1[REDACTED_SECRET]@",
      "caseInsensitive": true,
      "provenance": "structural"
    },
    {
      "id": "mysql-password-flag",
      "description": "MySQL and MariaDB client passwords glued to -p (mysql -pSECRET, mysqldump -p'SECRET'), also after grouped options that take no argument (mysql -vpSECRET), also when the executable itself is quoted (\"/usr/bin/mysql\" -pSECRET). Only the glued form: mysql -p db prompts and db is the database; -P is the port. The flag must sit in the same shell command as the client (no unquoted ; & | or newline in between; a backslash-newline continues it). Every later password argument of the same command is masked too, with what lies between.",
      "pattern": "\\b((?:[mM][yY][sS][qQ][lL](?:[dD][uU][mM][pP]|[aA][dD][mM][iI][nN]|[iI][mM][pP][oO][rR][tT]|[cC][hH][eE][cC][kK]|[sS][hH][oO][wW]|[pP][uU][mM][pP]|[sS][hH]|[bB][iI][nN][lL][oO][gG]|[sS][lL][aA][pP])?|[mM][aA][rR][iI][aA][dD][bB](?:-[a-zA-Z]+)?)(?:\\.[eE][xX][eE])?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+(?:-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*))*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "structural"
    },
    {
      "id": "mysql-quoted-password-flag",
      "description": "The same when the first password argument is quoted as a whole (mysql '-pMy pass', also in \"...\" or $'...'): the whole argument is masked, quotes included.",
      "pattern": "\\b((?:[mM][yY][sS][qQ][lL](?:[dD][uU][mM][pP]|[aA][dD][mM][iI][nN]|[iI][mM][pP][oO][rR][tT]|[cC][hH][eE][cC][kK]|[sS][hH][oO][wW]|[pP][uU][mM][pP]|[sS][hH]|[bB][iI][nN][lL][oO][gG]|[sS][lL][aA][pP])?|[mM][aA][rR][iI][aA][dD][bB](?:-[a-zA-Z]+)?)(?:\\.[eE][xX][eE])?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+)(?:'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*)(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+[^\\t\\n\\f\\r ;&|]+)*?(?:[ \\t]|\\\\\\r?\\n)+(?:-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-[ABCEFGHIJKLMNQRUVWXYZabfgjklmnoqstvxyz]*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*))*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "structural"
    },
    {
      "id": "sshpass-password-flag",
      "description": "sshpass -p passwords, glued, spaced or grouped (-vp). sshpass wraps a command, so only its own options (with the arguments of -P, -f and -d, also grouped as -vP) may come before -p, quoted or not: in sshpass -e ssh -p 2222 the -p belongs to ssh and is kept. Every later -p of sshpass is masked too.",
      "pattern": "\\b([sS][sS][hH][pP][aA][sS][sS](?:\\.[eE][xX][eE])?[\\\"']?(?:(?:[ \\t]|\\\\\\r?\\n)+(?:[\\\"']?-v*[fdP][\\\"']?(?:[ \\t]|\\\\\\r?\\n)*(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|[\\\"']?-[^\\t\\n\\f\\r ;&|]*))*?(?:[ \\t]|\\\\\\r?\\n)+-v*p(?:[ \\t]|\\\\\\r?\\n)*)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*(?:[^\\t\\n\\f\\r ;&|]*(?:(?:[ \\t]|\\\\\\r?\\n)+(?:[\\\"']?-v*[fdP][\\\"']?(?:[ \\t]|\\\\\\r?\\n)*(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|[\\\"']?-[^\\t\\n\\f\\r ;&|]*))*?(?:[ \\t]|\\\\\\r?\\n)+(?:(?:'-v*p'|\"-v*p\")(?:[ \\t]|\\\\\\r?\\n)+(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|-v*p(?:[ \\t]|\\\\\\r?\\n)*(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\"]*$|'[^']*$|`[^`]*$)(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|'-v*p[^']*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\"-v*p(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*|\\$'-v*p(?:\\\\[\\s\\S]|[^'\\\\])*'(?:\\$'(?:\\\\[\\s\\S]|[^'\\\\])*'|\\$|\"(?:\\\\[\\s\\S]|[^\\\"\\\\])*\"|'[^']*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|(?:[^\\t\\n\\f\\r &;|)\\\"'`\\\\$]|\\\\[\\s\\S])+|\"[^\\t\\n\\f\\r \"][^\"]*$|'[^\\t\\n\\f\\r '][^']*$|`[^\\t\\n\\f\\r `][^`]*$)*))*",
      "replacement": "$1[REDACTED_SECRET]",
      "caseInsensitive": false,
      "provenance": "structural"
    },
    {
      "id": "sshpass-quoted-password-flag",
