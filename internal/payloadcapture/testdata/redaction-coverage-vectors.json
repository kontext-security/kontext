{
  "valueVectors": [
    {
      "name": "pem-private-key",
      "ruleId": "private-key-block",
      "input": "config:\n-----BEGIN RSA PRIVATE KEY-----\nMIIfakekeymaterialFAKE\n-----END RSA PRIVATE KEY-----\ndone",
      "mustNotSurvive": ["MIIfakekeymaterialFAKE"]
    },
    {
      "name": "bare-bearer-token",
      "ruleId": "bearer-auth",
      "input": "echo Bearer bearer-secret-FAKE done",
      "mustNotSurvive": ["bearer-secret-FAKE"],
      "expected": "echo Bearer [REDACTED_SECRET] done"
    },
    {
      "name": "bare-basic-auth",
      "ruleId": "basic-auth",
      "input": "echo Basic dXNlcjpwYXNzd29yZA== done",
      "mustNotSurvive": ["dXNlcjpwYXNzd29yZA=="],
      "expected": "echo Basic [REDACTED_SECRET] done"
    },
    {
      "name": "plain-authorization-header",
      "ruleId": "authorization-header-double-quoted",
      "input": "curl -H \"Authorization: header-secret-FAKE\" https://api.example.test",
      "mustNotSurvive": ["header-secret-FAKE"],
      "expected": "curl -H \"Authorization: [REDACTED_SECRET]\" https://api.example.test"
    },
    {
      "name": "short-bearer-value-in-header-context",
      "ruleId": "authorization-header-single-quoted",
      "input": "curl -H 'Authorization: Bearer ab12' https://api.example.test",
      "mustNotSurvive": ["ab12"],
      "expected": "curl -H 'Authorization: Bearer [REDACTED_SECRET]' https://api.example.test"
    },
    {
      "name": "header-bearer-unclosed-quote-multiword",
      "ruleId": "authorization-header",
      "input": "set-header Authorization: Bearer \"multi word bearer-FAKE",
      "mustNotSurvive": ["multi word bearer-FAKE"],
      "expected": "set-header Authorization: Bearer [REDACTED_SECRET]"
    },
    {
      "name": "header-keeps-following-quoted-args",
      "ruleId": "authorization-header-double-quoted",
      "input": "curl -H \"Authorization: Bearer tok-FAKE\" -d '{\"k\":\"v\"}' https://api.example.test",
      "mustNotSurvive": ["tok-FAKE"],
      "expected": "curl -H \"Authorization: Bearer [REDACTED_SECRET]\" -d '{\"k\":\"v\"}' https://api.example.test"
    },
    {
      "name": "github-classic-token",
      "ruleId": "github-token",
      "input": "GITHUB_TOKEN is ghp_FAKE0123456789abcdefFAKE here",
      "mustNotSurvive": ["ghp_FAKE0123456789abcdefFAKE"]
    },
    {
      "name": "github-fine-grained-pat",
      "ruleId": "github-fine-grained-pat",
      "input": "use github_pat_11FAKEFAKE0123456789abcdef for auth",
      "mustNotSurvive": ["github_pat_11FAKEFAKE0123456789abcdef"]
    },
    {
      "name": "openai-style-key",
      "ruleId": "openai-api-key",
      "input": "OPENAI key sk-proj-FAKEabcdefghijklmnop1234",
      "mustNotSurvive": ["sk-proj-FAKEabcdefghijklmnop1234"]
    },
    {
      "name": "aws-access-key-id",
      "ruleId": "aws-access-key-id",
      "input": "aws configure set aws_access_key_id AKIAFAKEFAKEFAKEFAKE",
      "mustNotSurvive": ["AKIAFAKEFAKEFAKEFAKE"]
    },
    {
      "name": "slack-bot-token",
      "ruleId": "slack-token",
      "input": "SLACK_BOT_TOKEN xoxb-FAKE123456-FAKEabcdefghij",
      "mustNotSurvive": ["xoxb-FAKE123456-FAKEabcdefghij"]
    },
    {
      "name": "npm-token",
      "ruleId": "npm-token",
      "input": "//registry.npmjs.org/:_authToken=npm_FAKEabcdefghijklmnop12",
      "mustNotSurvive": ["npm_FAKEabcdefghijklmnop12"]
    },
    {
      "name": "gcp-api-key",
      "ruleId": "gcp-api-key",
      "input": "maps client key AIzaFAKE1234567890abcdefghij end",
      "mustNotSurvive": ["AIzaFAKE1234567890abcdefghij"]
    },
    {
      "name": "jwt",
      "ruleId": "jwt",
      "input": "session eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.FAKEsignatureFAKE1234",
      "mustNotSurvive": [
        "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.FAKEsignatureFAKE1234"
      ]
    },
    {
      "name": "url-userinfo",
      "ruleId": "url-userinfo",
      "input": "git clone https://deploy:hunter2FAKEpass@git.example.test/repo.git",
      "mustNotSurvive": ["hunter2FAKEpass"],
      "expected": "git clone https://[REDACTED_SECRET]@git.example.test/repo.git"
    },
    {
      "name": "url-userinfo-database-url",
      "ruleId": "url-userinfo",
      "input": "DATABASE_URL=postgres://app:FAKEpgpass123@db.example.test:5432/app psql -c 'select 1'",
      "mustNotSurvive": ["FAKEpgpass123"],
      "expected": "DATABASE_URL=postgres://[REDACTED_SECRET]@db.example.test:5432/app psql -c 'select 1'"
    },
    {
      "name": "url-userinfo-mongodb-srv",
      "ruleId": "url-userinfo",
      "input": "mongosh \"mongodb+srv://svc:FAKEmongo42@cluster0.example.test/app\"",
      "mustNotSurvive": ["FAKEmongo42"],
      "expected": "mongosh \"mongodb+srv://[REDACTED_SECRET]@cluster0.example.test/app\""
    },
    {
      "name": "url-userinfo-password-only",
      "ruleId": "url-userinfo",
      "input": "redis-cli --uri redis://:FAKEredis99@cache.example.test:6379/0",
      "mustNotSurvive": ["FAKEredis99"],
      "expected": "redis-cli --uri redis://[REDACTED_SECRET]@cache.example.test:6379/0"
    },
    {
      "name": "url-userinfo-at-sign-password",
      "ruleId": "url-userinfo",
      "input": "psql postgresql://app:FAKEat@signtail@db.example.test/app",
      "mustNotSurvive": ["FAKEat", "signtail"],
      "expected": "psql postgresql://[REDACTED_SECRET]@db.example.test/app"
    },
    {
      "name": "url-userinfo-apostrophe-password",
      "ruleId": "url-userinfo",
      "input": "psql \"postgres://app:FAKEpa'ss@db.example.test/app\"",
      "mustNotSurvive": ["FAKEpa'ss"],
      "expected": "psql \"postgres://[REDACTED_SECRET]@db.example.test/app\""
    },
    {
      "name": "url-userinfo-after-word-character",
      "ruleId": "url-userinfo",
      "input": "see _https://alice:FAKEunderscore1@db.example.test/path_ and x_postgres://app:FAKEunderscore2@db.example.test/app",
      "mustNotSurvive": ["FAKEunderscore1", "FAKEunderscore2"],
      "expected": "see _https://[REDACTED_SECRET]@db.example.test/path_ and x_postgres://[REDACTED_SECRET]@db.example.test/app"
    },
    {
      "name": "auth-assignment",
      "ruleId": "auth-assignment",
      "input": "AUTH=FAKEauth1 run && x auth:'FAKEauth2' && y Authorization=FAKEauth3",
      "mustNotSurvive": ["FAKEauth1", "FAKEauth2", "FAKEauth3"],
      "expected": "AUTH=[REDACTED_SECRET] run && x auth:[REDACTED_SECRET] && y Authorization=[REDACTED_SECRET]"
    },
    {
      "name": "auth-assignment-short-basic",
      "ruleId": "auth-assignment",
      "input": "auth=Basic dTpw run",
      "mustNotSurvive": ["dTpw"],
      "expected": "auth=Basic [REDACTED_SECRET] run"
    },
    {
      "name": "cli-flag-extra-whitespace",
      "ruleId": "sensitive-cli-flag",
      "input": "curl --token  FAKEflag1 --password\tFAKEflag2 x",
      "mustNotSurvive": ["FAKEflag1", "FAKEflag2"]
    },
    {
      "name": "query-param-apostrophe",
      "ruleId": "sensitive-query-param",
      "input": "curl https://api.example.test/?key=FAKEq'uotetail x",
      "mustNotSurvive": ["FAKEq", "uotetail"]
    },
    {
      "name": "assignment-escaped-newline",
      "ruleId": "sensitive-assignment",
      "input": "PASSWORD=\"FAKEnl\\\nnltail\" run",
      "mustNotSurvive": ["FAKEnl", "nltail"]
    },
    {
      "name": "assignment-unterminated-with-escape",
      "ruleId": "sensitive-assignment",
      "input": "PASSWORD=\"FAKEun\\\"untail",
      "mustNotSurvive": ["FAKEun", "untail"]
    },
    {
      "name": "assignment-concatenated-empty-quotes",
      "ruleId": "sensitive-assignment",
      "input": "PASSWORD=FAKEcat''cattail run",
      "mustNotSurvive": ["FAKEcat", "cattail"]
    },
    {
      "name": "assignment-concatenated-space-quote",
      "ruleId": "sensitive-assignment",
      "input": "PASSWORD=FAKEsq' sq tail' run",
      "mustNotSurvive": ["FAKEsq", "sq tail"]
    },
    {
      "name": "single-quoted-header-then-quoted-password",
      "ruleId": "authorization-header-single-quoted",
      "input": "curl -H 'Authorization: Bearer FAKEhdr1' PASSWORD='FAKEpw1 FAKEpw2' x",
      "mustNotSurvive": ["FAKEhdr1", "FAKEpw1", "FAKEpw2"],
