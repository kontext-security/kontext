    },
    {
      "name": "quoted-header-mixed-quote-segments",
      "ruleId": "authorization-header-double-quoted",
      "input": "curl -H \"Authorization: \"'Bearer FAKEmixed1 FAKEmixed2' x",
      "mustNotSurvive": ["FAKEmixed1", "FAKEmixed2"]
    },
    {
      "name": "quoted-header-then-semicolon-assignment",
