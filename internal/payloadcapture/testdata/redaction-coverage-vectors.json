      "input": "curl -H \"Authorization: Bearer FAKEhdr2\" PASSWORD=\"FAKEpw3 FAKEpw4\" x",
      "mustNotSurvive": ["FAKEhdr2", "FAKEpw3", "FAKEpw4"],
      "expected": "curl -H \"Authorization: Bearer [REDACTED_SECRET]\" PASSWORD=[REDACTED_SECRET] x"
    },
    {
      "name": "json-authorization-property",
      "ruleId": "json-sensitive-property",
      "input": "echo '{\"Authorization\":\"Bearer x\",\"auth\":\"FAKEjsonauth\"}'",
      "mustNotSurvive": ["Bearer x", "FAKEjsonauth"]
    },
    {
      "name": "quoted-header-adjacent-segment",
      "ruleId": "authorization-header-double-quoted",
      "input": "curl -H \"Authorization: Bearer \"\"FAKEadjacent1\" -H 'Authorization: Bearer '\"FAKEadjacent2\" x",
      "mustNotSurvive": ["FAKEadjacent1", "FAKEadjacent2"]
    },
    {
      "name": "query-param-double-quote",
      "ruleId": "sensitive-query-param",
      "input": "curl 'https://api.example.test/?key=FAKEdq\"dqtail' x",
