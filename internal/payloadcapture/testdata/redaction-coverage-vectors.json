    {
      "name": "unterminated-value-trailing-backslash",
      "ruleId": "sensitive-assignment",
      "input": "PASSWORD=\"FAKEtail1\\",
      "mustNotSurvive": ["FAKEtail1"]
    },
    {
      "name": "unterminated-flag-trailing-backslash",
      "ruleId": "sensitive-cli-flag",
      "input": "--password \"FAKEtail2\\",
      "mustNotSurvive": ["FAKEtail2"]
    },
    {
      "name": "assignment-escaped-space",
      "ruleId": "sensitive-assignment",
      "input": "PGPASSWORD=FAKEdemo\\ FAKEsword psql",
      "mustNotSurvive": ["FAKEdemo", "FAKEsword"]
    },
    {
      "name": "userinfo-escaped-space",
