{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontext.security/schemas/browser-contract-v2.json",
  "title": "Kontext browser event contract v2",
  "$comment": "Every branch is told apart by its discriminator: type for messages, schema for the cloud batch, and no type, schema or contract for the cloud's answer.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/records" },
    { "$ref": "#/$defs/settings" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/cloudBatch" },
    { "$ref": "#/$defs/cloudResponse" }
  ],
  "$defs": {
    "contract": { "const": 2 },
    "time": {
      "$comment": "The pattern holds the RFC 3339 shape for a validator that does not check formats.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "maxLength": 40
    },
    "day": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "browser": { "enum": ["chrome", "edge", "chromium"] },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "appId": {
      "$comment": "The ids in catalog.json, in its order; a test in internal/browserevents checks they match.",
      "enum": ["chatgpt", "claude", "gemini", "copilot", "lovable", "n8n-cloud"]
    },
    "label": {
      "$comment": "A catalog name such as an app or a provider, never page text: letters, digits, spaces and . & + ' ( ) -.",
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} .&+'()-]{0,39}$",
      "maxLength": 40
    },
    "enrollment": {
      "$comment": "Opaque id of the enrollment the daemon records under, empty until it has one. When it changes, the extension drops what it kept for the previous one.",
      "type": "string",
      "pattern": "^([0-9a-f]{16})?$"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "maxLength": 253
    },
    "extension": {
      "type": "object",
      "required": ["version", "browser", "profile"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "browser": { "$ref": "#/$defs/browser" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "health": {
      "type": "object",
      "required": ["kind", "connected_since", "observed_at"],
      "properties": {
        "kind": { "const": "health" },
        "connected_since": { "$ref": "#/$defs/time" },
        "observed_at": { "$ref": "#/$defs/time" }
      }
    },
    "visit": {
      "type": "object",
      "required": [
        "kind", "day", "app", "app_name", "provider", "surface", "host",
        "first_seen", "last_seen", "requests"
      ],
      "properties": {
        "kind": { "const": "visit" },
        "day": { "$ref": "#/$defs/day" },
        "app": { "$ref": "#/$defs/appId" },
        "app_name": { "$ref": "#/$defs/label" },
        "provider": { "$ref": "#/$defs/label" },
        "surface": { "const": "web" },
        "host": { "$ref": "#/$defs/host" },
        "first_seen": { "$ref": "#/$defs/time" },
        "last_seen": { "$ref": "#/$defs/time" },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Page loads plus POST requests to the app's hosts that UTC day, so far."
        }
      }
    },
    "accountKeys": {
      "$comment": "The only keys an account record may have, so an address, a name or a token cannot pass as an extra field. There is no host: the app id names the app, and a tenant subdomain or an email domain has no field to travel in.",
      "propertyNames": { "enum": ["kind", "day", "app", "account_type", "observed_at"] }
    },
    "account": {
      "$comment": "Which type of account was signed in to an app that UTC day, at its newest observation. Only the type: never a plan, an address, a domain or a name.",
      "type": "object",
      "required": ["kind", "day", "app", "account_type", "observed_at"],
      "properties": {
        "kind": { "const": "account" },
        "day": { "$ref": "#/$defs/day" },
        "app": { "$ref": "#/$defs/appId" },
        "account_type": {
          "enum": ["company", "personal", "none", "unknown"],
          "description": "company: the active workspace is a managed one (team or enterprise); its owner is not checked. personal: any other signed-in account, also on a work email. none: the app answered that nobody is signed in. unknown: the app answered, but its answer could not be classified. A failed read sends no record."
        },
        "observed_at": { "$ref": "#/$defs/time" }
      }
    },
    "record": {
      "oneOf": [{ "$ref": "#/$defs/health" }, { "$ref": "#/$defs/visit" }, { "allOf": [{ "$ref": "#/$defs/account" }, { "$ref": "#/$defs/accountKeys" }] }]
    },
    "hello": {
      "type": "object",
      "required": ["contract", "type", "extension"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "hello" },
        "extension": { "$ref": "#/$defs/extension" }
      }
    },
    "records": {
      "type": "object",
      "required": ["contract", "type", "extension", "records", "enrollment"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "records" },
        "extension": { "$ref": "#/$defs/extension" },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/record" }
        },
        "enrollment": { "$ref": "#/$defs/enrollment" }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["index", "reason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "maxLength": 200 }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "contract", "type", "capture_mode", "corporate_domains", "paused",
        "accepted", "rejected", "enrollment"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "settings" },
        "capture_mode": { "enum": ["commands", "full", "prompts"] },
        "corporate_domains": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/host" }
        },
        "paused": { "type": "boolean" },
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejection" } },
        "enrollment": { "$ref": "#/$defs/enrollment" }
      }
    },
    "error": {
      "type": "object",
      "required": ["contract", "type", "error"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "error" },
        "error": { "enum": ["unsupported_contract", "invalid_message", "unavailable"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["browser", "profile", "extension_version"],
      "properties": {
        "browser": { "$ref": "#/$defs/browser" },
        "profile": { "$ref": "#/$defs/profile" },
        "extension_version": { "$ref": "#/$defs/version" }
      }
    },
    "healthFields": {
      "anyOf": [{ "required": ["connected_since"] }, { "required": ["observed_at"] }]
    },
    "visitFields": {
      "anyOf": [
        { "required": ["day"] }, { "required": ["app"] }, { "required": ["app_name"] },
        { "required": ["provider"] }, { "required": ["surface"] }, { "required": ["host"] },
        { "required": ["first_seen"] }, { "required": ["last_seen"] }, { "required": ["requests"] }
      ]
    },
    "accountFields": {
      "anyOf": [{ "required": ["account_type"] }]
    },
    "cloudRecord": {
      "$comment": "Stricter than an extension's record: the daemon sends only the fields of a record's kind, so a health record with a host, a visit with an account type, or an account with any field but its own and the source, is refused.",
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "oneOf": [
            {
              "allOf": [
                { "$ref": "#/$defs/health" },
                { "not": { "$ref": "#/$defs/visitFields" } },
                { "not": { "$ref": "#/$defs/accountFields" } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/visit" },
                { "not": { "$ref": "#/$defs/healthFields" } },
                { "not": { "$ref": "#/$defs/accountFields" } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/account" },
                {
                  "propertyNames": {
                    "enum": [
                      "kind", "day", "app", "account_type", "observed_at",
                      "browser", "profile", "extension_version"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "cloudBatch": {
      "type": "object",
      "required": ["schema", "installation_id", "sent_at", "records"],
      "not": { "required": ["type"] },
      "properties": {
        "schema": { "const": "browser-activity-v1" },
        "installation_id": { "type": "string", "pattern": "^ins_[A-Za-z0-9_-]{32}$" },
        "sent_at": { "$ref": "#/$defs/time" },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/cloudRecord" }
        }
      }
    },
    "cloudResponse": {
      "type": "object",
      "required": ["accepted", "rejected"],
      "not": {
        "anyOf": [{ "required": ["type"] }, { "required": ["schema"] }, { "required": ["contract"] }]
      },
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejection" } }
      }
    }
  }
}
