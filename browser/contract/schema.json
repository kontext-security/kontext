{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontext.security/schemas/browser-contract-v1.json",
  "title": "Kontext browser event contract v1",
  "$comment": "Every branch is told apart by its discriminator: type for messages, schema for the cloud batch, and no type, schema or contract for the cloud's answer.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/records" },
    { "$ref": "#/$defs/settings" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/cloudBatch" },
    { "$ref": "#/$defs/cloudResponse" }
  ],
  "$defs": {
    "contract": { "const": 1 },
    "time": { "type": "string", "format": "date-time", "maxLength": 40 },
    "day": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "browser": { "enum": ["chrome", "edge", "chromium"] },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "appId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "label": {
      "$comment": "A catalog name such as an app or a provider, never page text: letters, digits, spaces and . & + ' ( ) -.",
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} .&+'()-]{0,39}$",
      "maxLength": 40
    },
    "enrollment": {
      "$comment": "Opaque id of the enrollment the daemon records under, empty until it has one. When it changes, the extension drops what it kept for the previous one.",
      "type": "string",
      "pattern": "^([0-9a-f]{16})?$"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "maxLength": 253
    },
    "extension": {
      "type": "object",
      "required": ["version", "browser", "profile"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "browser": { "$ref": "#/$defs/browser" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "health": {
      "type": "object",
      "required": ["kind", "connected_since", "observed_at"],
      "properties": {
        "kind": { "const": "health" },
        "connected_since": { "$ref": "#/$defs/time" },
        "observed_at": { "$ref": "#/$defs/time" }
      }
    },
    "visit": {
      "type": "object",
      "required": [
        "kind", "day", "app", "app_name", "provider", "surface", "host",
        "first_seen", "last_seen", "requests"
      ],
      "properties": {
        "kind": { "const": "visit" },
        "day": { "$ref": "#/$defs/day" },
        "app": { "$ref": "#/$defs/appId" },
        "app_name": { "$ref": "#/$defs/label" },
        "provider": { "$ref": "#/$defs/label" },
        "surface": { "const": "web" },
        "host": { "$ref": "#/$defs/host" },
        "first_seen": { "$ref": "#/$defs/time" },
        "last_seen": { "$ref": "#/$defs/time" },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Page loads plus POST requests to the app's hosts that UTC day, so far."
        },
        "messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Messages sent, approximate: how many of the requests were sends to the app's message endpoint. A regenerate or an edit counts too. Missing reads as 0. At most requests."
        }
      }
    },
    "account": {
      "$comment": "Which kind of account was signed in to an app that UTC day, at its newest observation. Never an address: email_domain is sent only for a corporate account, and a personal account carries no domain.",
      "type": "object",
      "required": ["kind", "day", "app", "host", "plan", "observed_at"],
      "properties": {
        "kind": { "const": "account" },
        "day": { "$ref": "#/$defs/day" },
        "app": { "$ref": "#/$defs/appId" },
        "host": { "$ref": "#/$defs/host" },
        "plan": {
          "enum": ["anonymous", "free", "paid", "team", "enterprise", "unknown"],
          "description": "anonymous: not signed in. free and paid: a personal account. team and enterprise: an organisation's workspace. unknown: the app's answer could not be read."
        },
        "corporate": {
          "type": "boolean",
          "description": "A team or enterprise workspace, or an account whose email domain is one of corporate_domains. Missing reads as false."
        },
        "email_domain": { "$ref": "#/$defs/host" },
        "observed_at": { "$ref": "#/$defs/time" }
      },
      "allOf": [
        { "if": { "required": ["email_domain"] }, "then": { "required": ["corporate"], "properties": { "corporate": { "const": true } } } },
        { "if": { "properties": { "plan": { "const": "anonymous" } } }, "then": { "not": { "properties": { "corporate": { "const": true } }, "required": ["corporate"] } } }
      ]
    },
    "record": {
      "oneOf": [{ "$ref": "#/$defs/health" }, { "$ref": "#/$defs/visit" }, { "$ref": "#/$defs/account" }]
    },
    "hello": {
      "type": "object",
      "required": ["contract", "type", "extension"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "hello" },
        "extension": { "$ref": "#/$defs/extension" }
      }
    },
    "records": {
      "type": "object",
      "required": ["contract", "type", "extension", "records", "enrollment"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "records" },
        "extension": { "$ref": "#/$defs/extension" },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/record" }
        },
        "enrollment": { "$ref": "#/$defs/enrollment" }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["index", "reason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "maxLength": 200 }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "contract", "type", "capture_mode", "corporate_domains", "paused",
        "accepted", "rejected", "enrollment"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "settings" },
        "capture_mode": { "enum": ["commands", "full", "prompts"] },
        "corporate_domains": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/host" }
        },
        "paused": { "type": "boolean" },
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejection" } },
        "enrollment": { "$ref": "#/$defs/enrollment" }
      }
    },
    "error": {
      "type": "object",
      "required": ["contract", "type", "error"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "type": { "const": "error" },
        "error": { "enum": ["unsupported_contract", "invalid_message", "unavailable"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["browser", "profile", "extension_version"],
      "properties": {
        "browser": { "$ref": "#/$defs/browser" },
        "profile": { "$ref": "#/$defs/profile" },
        "extension_version": { "$ref": "#/$defs/version" }
      }
    },
    "healthFields": {
      "anyOf": [{ "required": ["connected_since"] }, { "required": ["observed_at"] }]
    },
    "visitFields": {
      "anyOf": [
        { "required": ["day"] }, { "required": ["app"] }, { "required": ["app_name"] },
        { "required": ["provider"] }, { "required": ["surface"] }, { "required": ["host"] },
        { "required": ["first_seen"] }, { "required": ["last_seen"] }, { "required": ["requests"] },
        { "required": ["messages"] }
      ]
    },
    "visitOnlyFields": {
      "anyOf": [
        { "required": ["app_name"] }, { "required": ["provider"] }, { "required": ["surface"] },
        { "required": ["first_seen"] }, { "required": ["last_seen"] }, { "required": ["requests"] },
        { "required": ["messages"] }
      ]
    },
    "accountFields": {
      "anyOf": [{ "required": ["plan"] }, { "required": ["corporate"] }, { "required": ["email_domain"] }]
    },
    "cloudRecord": {
      "$comment": "Stricter than an extension's record: the daemon sends only the fields of a record's kind, so a health record with a host, or a visit with a plan, is refused.",
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "oneOf": [
            {
              "allOf": [
                { "$ref": "#/$defs/health" },
                { "not": { "$ref": "#/$defs/visitFields" } },
                { "not": { "$ref": "#/$defs/accountFields" } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/visit" },
                { "not": { "$ref": "#/$defs/healthFields" } },
                { "not": { "$ref": "#/$defs/accountFields" } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/account" },
                { "not": { "required": ["connected_since"] } },
                { "not": { "$ref": "#/$defs/visitOnlyFields" } }
              ]
            }
          ]
        }
      ]
    },
    "cloudBatch": {
      "type": "object",
      "required": ["schema", "installation_id", "sent_at", "records"],
      "not": { "required": ["type"] },
      "properties": {
        "schema": { "const": "browser-activity-v1" },
        "installation_id": { "type": "string", "pattern": "^ins_[A-Za-z0-9_-]{32}$" },
        "sent_at": { "$ref": "#/$defs/time" },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/cloudRecord" }
        }
      }
    },
    "cloudResponse": {
      "type": "object",
      "required": ["accepted", "rejected"],
      "not": {
        "anyOf": [{ "required": ["type"] }, { "required": ["schema"] }, { "required": ["contract"] }]
      },
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejection" } }
      }
    }
  }
}
