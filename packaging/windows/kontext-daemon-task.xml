<!--
  Logon task that starts the per-user Kontext daemon. kontext-install.js
  puts the installed kontextw.exe into <Command> and registers the result as
  \Kontext\Kontext Daemon.

  - Principal: the Users group (S-1-5-32-545), so the task starts for every
    user who logs on, in that user's session, with that user's limited token.
  - Parallel instances: one daemon per logged-on user.
  - No execution time limit, allowed and kept running on battery.
  - Restart on failure: every minute, up to 999 times.
  - Priority 5 (normal): the default 7 is below normal, and hooks wait for the
    daemon.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Kontext</Author>
    <Description>Starts the Kontext daemon for each user who logs on.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Users">
      <GroupId>S-1-5-32-545</GroupId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>Parallel</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Users">
    <Exec>
      <Command>@KONTEXTW_EXE@</Command>
      <Arguments>managed-observe-daemon</Arguments>
    </Exec>
  </Actions>
</Task>
